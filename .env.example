# Copy to .env and adjust. .env is gitignored; this file is tracked.
#
# These are LOCAL SANDBOX credentials for a throwaway container. Production
# credentials belong in a secret manager (Vault, AWS Secrets Manager) and are
# injected at runtime -- never a file, never in git.

# --- PostgreSQL ---
POSTGRES_DB=ecommerce
POSTGRES_USER=streaming
POSTGRES_PASSWORD=change_me

# Host differs by vantage point, and this trips everyone up once:
#   postgres  -> from inside the Docker network (what Spark uses; the compose
#                service name). Inside a container, "localhost" is that
#                container itself, not the database.
#   localhost -> from Windows (psql, DBeaver, pgAdmin)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Port published to the Windows host. Change if 5432 is already taken by a
# native PostgreSQL install.
POSTGRES_HOST_PORT=5432

# --- Adminer (browser SQL client, `make adminer`) ---
# Port published to the Windows host. 8080 is a popular default, so change this
# if something else on your machine already owns it.
ADMINER_HOST_PORT=8080

# --- Streaming knobs ---
# Kept in env so the load matrix can vary them without editing code.
MAX_FILES_PER_TRIGGER=20
TRIGGER_INTERVAL=10 seconds
SHUFFLE_PARTITIONS=4
JDBC_BATCH_SIZE=5000
